# H02-e: el repositorio guarda texto con LF sin depender de core.autocrlf de cada equipo.
# Las migraciones validan su checksum sin importar el fin de línea (backend/migration-checksum.js).
* text=auto

*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.dump binary
*.woff binary
*.woff2 binary
*.zip binary

# O05: el esquema base se versiona byte por byte (funciones con CRLF y datos COPY con LF); git no debe convertirlo.
backend/schema/*.sql -text
