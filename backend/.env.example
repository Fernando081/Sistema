# Opción A: URL completa (recomendada para nube)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opción B: parámetros sueltos (ideal para local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Activa SSL solo si tu proveedor lo requiere (ej. algunos servicios cloud)
DB_SSL=false
# Los certificados se verifican por defecto. Producción exige esta verificación.
DB_SSL_REJECT_UNAUTHORIZED=true

# Seguridad. El fallback por variables solo debe habilitarse temporalmente
# para bootstrap local; el login normal usa auth_user.
# Genera al menos 32 bytes aleatorios; el valor de ejemplo se rechaza en producción.
JWT_SECRET=replace-with-a-random-32-character-secret
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-local-dev-password
ALLOW_ENV_AUTH=false

# Fiscal: mock no hace llamadas externas. sandbox usa exclusivamente SW pruebas.
FISCAL_MODE=mock
PAC_PROVIDER=sw
FISCAL_ISSUER_RFC=EKU9003173C9
FISCAL_ISSUER_NAME=ESCUELA KEMPER URGATE
FISCAL_ISSUER_TAX_REGIME=601
FISCAL_ISSUER_POSTAL_CODE=26015
# Usa usuario/contraseña o un token creado en el portal del PAC. Nunca confirmes estos valores.
PAC_SW_USER=
PAC_SW_PASSWORD=
PAC_SW_TOKEN=
# Doble seguro: production no arranca operaciones fiscales sin esta bandera exacta.
FISCAL_PRODUCTION_ENABLED=false

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300,http://localhost:4400,http://127.0.0.1:4400
# Producción: lista explícita de orígenes HTTPS. Proxy del ERP hacia /api/v1.
# Activar únicamente con reverse proxy local confiable que sustituya X-Forwarded-Proto.
AUTH_TRUST_LOOPBACK_PROXY=false
PORT=3100

# Mantenimiento de bandeja web: activar solo con política de retención aprobada.
WEB_INBOX_PURGE_ENABLED=false

# Puente exclusivo de solicitudes: desactivado hasta aviso/adaptador aprobados.
WEB_LEAD_BRIDGE_ENABLED=false
WEB_LEAD_BRIDGE_KEY=
WEB_LEAD_PRIVACY_VERSION=

# Rotación v2: ID de firma y clave ESTABLE de huellas en base64 (>=32 bytes).
# Campos vacíos conservan protocolo legacy. Configuración parcial cierra recepción.
WEB_LEAD_BRIDGE_KEY_ID=
WEB_LEAD_FINGERPRINT_KEY=
# Opcionales en conjunto; intervalo UTC ISO con milisegundos, máximo 24 horas.
# PREVIOUS_ID=legacy acepta v1 solo dentro del intervalo; es un ID, no una clave.
WEB_LEAD_BRIDGE_PREVIOUS_KEY=
WEB_LEAD_BRIDGE_PREVIOUS_ID=
WEB_LEAD_BRIDGE_PREVIOUS_FROM=
WEB_LEAD_BRIDGE_PREVIOUS_UNTIL=

# MFA opcional: clave ESTABLE de 32 bytes en base64; nunca publicarla ni regenerarla al reiniciar.
# Conservar respaldo separado y protegido: perderla impide verificar los autenticadores inscritos.
# Si falta, las cuentas sin MFA funcionan, pero no se puede configurar MFA.
AUTH_MFA_ENCRYPTION_KEY=
